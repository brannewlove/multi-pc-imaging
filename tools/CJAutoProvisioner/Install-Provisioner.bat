@echo off
setlocal enabledelayedexpansion
title CJ ?? ????? ?? ????? ?? ?? ??
cd /d "%~dp0"

echo ==============================================================================
echo   [CJ Auto Provisioner] ?? ????? ? assigned_info.json ?? ?? ??
echo ==============================================================================
echo.
echo  ? ??? ?? PC ?? ?? ????(W:\ ?)? 
echo  ?? ?????(CJAutoProvisioner.exe)? ?? ??(assigned_info.json), 
echo  ??? ? ?? ? ?? ?? ????(SetupComplete.cmd / RunOnce)? 
echo  ?? ???? ?????.
echo.

REM ------------------------------------------------------------------------------
REM 1. ?? ?? ???? ??
REM ------------------------------------------------------------------------------
set "TARGET_DRIVE=C:"
echo [1/3] ?? ?? ????? ?????.
echo  - ?? ?? ???? ??: C: (???)
echo  - WinPE?? ??? ?? ????? ??: W:
set /p "USER_DRIVE=?? ?? ???? (??: C:) : "
if not "%USER_DRIVE%"=="" set "TARGET_DRIVE=%USER_DRIVE%"
set "TARGET_DRIVE=%TARGET_DRIVE::=%"
set "TARGET_DRIVE=%TARGET_DRIVE%:"

echo  -> ?? ????: %TARGET_DRIVE%
echo.

REM ------------------------------------------------------------------------------
REM 2. CJ_ID (??) ?? ?? ? ?? ????? ??? ??
REM ------------------------------------------------------------------------------
echo [2/3] ?? ??(assigned_info.json) ???? ?????.
echo.
echo  [CASE A] ??/ID? ?? ??? ?? : ?? CJ_ID ?? (?: cjencmaster, CJ10041)
echo  [CASE B] ?? ? ?? ??? ??    : ???? ???? ?? [Enter]
echo.
set "INPUT_ID="
set /p "INPUT_ID=CJ_ID ?? (?? ? ???? ??) : "

echo.
set "PROV_ENABLED=true"
set /p "INPUT_ENABLED=?? ????? ??? ?? (Y/N, ???: Y) : "
if /i "%INPUT_ENABLED%"=="N" (
    set "PROV_ENABLED=false"
    echo  -> ?? ?????: ???? (enabled=false)
) else (
    set "PROV_ENABLED=true"
    echo  -> ?? ?????: ??? (enabled=true)
)
echo.

REM ------------------------------------------------------------------------------
REM 3. ?? ?? ?? ? assigned_info.json ??
REM ------------------------------------------------------------------------------
echo [3/3] ?? ????(%TARGET_DRIVE%)? ????? ?? ?? ?...

set "DEPLOY_DIR=%TARGET_DRIVE%\Temp\CJ_Work\MultiDeploy"
if not exist "%DEPLOY_DIR%" mkdir "%DEPLOY_DIR%"

REM (1) assigned_info.json ?? ??
set "JSON_FILE=%DEPLOY_DIR%\assigned_info.json"
(
    echo {
    echo   "enabled": %PROV_ENABLED%,
    echo   "assignedId": "%INPUT_ID%"
    echo }
) > "%JSON_FILE%"

echo  [OK] assigned_info.json ?? ??: %JSON_FILE%
echo       - enabled    : %PROV_ENABLED%
if "%INPUT_ID%"=="" (
    echo       - assignedId : (?? - CASE B ???? ??)
) else (
    echo       - assignedId : "%INPUT_ID%" (CASE A ???? ??)
)

REM (2) CJAutoProvisioner.exe ?? ??
set "SOURCE_EXE="
if exist "%~dp0dist\CJAutoProvisioner.exe" (
    set "SOURCE_EXE=%~dp0dist\CJAutoProvisioner.exe"
) else if exist "%~dp0dist\CJAutoProvisioner_Net8.exe" (
    set "SOURCE_EXE=%~dp0dist\CJAutoProvisioner_Net8.exe"
) else (
    echo  [BUILD] ???? ?? ??? ?? csc.exe? ?? ?????...
    call "%~dp0Build-Provisioner.bat" >nul 2>nul
    if exist "%~dp0dist\CJAutoProvisioner.exe" set "SOURCE_EXE=%~dp0dist\CJAutoProvisioner.exe"
)

if not "%SOURCE_EXE%"=="" (
    copy /y "%SOURCE_EXE%" "%DEPLOY_DIR%\CJAutoProvisioner.exe" >nul
    echo  [OK] CJAutoProvisioner.exe ?? ??: %DEPLOY_DIR%\CJAutoProvisioner.exe
) else (
    echo  [WARNING] CJAutoProvisioner.exe ?? ??? ?? ?????. PowerShell ????? ?? ?????.
    copy /y "%~dp0CJAutoProvisioner.ps1" "%DEPLOY_DIR%\CJAutoProvisioner.ps1" >nul
)

REM (3) ? ?? ?? ?? ????(SetupComplete.cmd) ??
set "SCRIPTS_DIR=%TARGET_DRIVE%\Windows\Setup\Scripts"
if not exist "%SCRIPTS_DIR%" mkdir "%SCRIPTS_DIR%"
copy /y "%~dp0SetupComplete.cmd" "%SCRIPTS_DIR%\SetupComplete.cmd" >nul
echo  [OK] SetupComplete.cmd ?? ??: %SCRIPTS_DIR%\SetupComplete.cmd

REM (4) ?? ???(C:)? ?? RunOnce ?????? ?? ??
if /i "%TARGET_DRIVE%"=="C:" (
    reg add "HKLM\Software\Microsoft\Windows\CurrentVersion\RunOnce" /v "CJAutoProvisioner" /t REG_SZ /d "\"%DEPLOY_DIR%\CJAutoProvisioner.exe\"" /f >nul 2>nul
    echo  [OK] HKLM RunOnce ????? ?? ??
)

echo.
echo ==============================================================================
echo  [?? ??] ?? ?????? assigned_info.json? ?? ???????!
echo ==============================================================================
echo.
echo  - ?? ????: %DEPLOY_DIR%
echo  - ?? ?? ??: %JSON_FILE%
