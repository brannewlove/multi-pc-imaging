echo.
echo  ?? PC? ?????? ??? ? ??(OOBE)? ????
echo  ?????? setup_config.ini? ???? ??? ????
echo  AutoSetup2.0.exe? [?? ??] ??? ??? ? ?? ?? ?????.
echo.

set /p "TEST_RUN=?? ?? ?????? 1? ??? ??? ??????? (Y/N, ??: N) : "
if /i "%TEST_RUN%"=="Y" (
    echo.
    echo [*] CJAutoProvisioner.exe ?? ?...
    start "" "%DEPLOY_DIR%\CJAutoProvisioner.exe"
)

echo.
echo ??? ????. ?? ?? ???? ?? ????.
pause >nul
endlocal
