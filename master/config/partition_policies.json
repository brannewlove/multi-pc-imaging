[
  {
    "id": "policy-nvme-1tb-single",
    "name": "1TB NVMe 단일 드라이브 (C드라이브 단독 구성)",
    "description": "1TB급 NVMe SSD 1개 탑재 모델용 기본 GPT 파티션",
    "conditions": {
      "modelPattern": "*",
      "diskCountMin": 1,
      "diskCountMax": 99,
      "targetDiskCriteria": "NVME_FIRST",
      "targetDiskIndex": 0,
      "minCapacityGb": 900.0,
      "maxCapacityGb": 1050.0
    },
    "autoApprove": true,
    "partitionScheme": "GPT",
    "layout": [
      {
        "type": "EFI",
        "sizeMb": 300,
        "fs": "FAT32",
        "label": "System",
        "letter": "S"
      },
      {
        "type": "MSR",
        "sizeMb": 16
      },
      {
        "type": "OS",
        "sizeMb": "REMAINDER",
        "fs": "NTFS",
        "label": "Windows",
        "letter": "W"
      }
    ],
    "postInstall": {
      "runBcdBoot": true,
      "bootLetter": "S:",
      "osLetter": "W:\\Windows"
    }
  },
