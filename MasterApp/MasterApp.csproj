<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>annotations</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MultiDeployOS.Master</RootNamespace>
    <AssemblyName>MultiDeployMaster</AssemblyName>
    <ApplicationTitle>MultiDeployOS - 다중 PC 자동화 이미지 배포 관제 시스템</ApplicationTitle>
    <Version>1.0.0</Version>
    <Company>MultiDeployOS</Company>
    <Product>MultiDeployOS Master Native</Product>
  </PropertyGroup>

  <ItemGroup>
    <None Update="config\**\*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>